<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<GameVersion Condition="'$(GameVersion)' == ''">1.6</GameVersion>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<AssemblyName>TechLeveler</AssemblyName>
		<RootNamespace>TechLeveler</RootNamespace>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<OutputPath>..\$(GameVersion)\Assemblies\</OutputPath>
		<BaseIntermediateOutputPath>obj\$(GameVersion)\</BaseIntermediateOutputPath>
		<DefaultItemExcludes>$(DefaultItemExcludes);obj/**;UIRethemedCompat/**</DefaultItemExcludes>
		<ManagedDir>..\..\..\RimWorldWin64_Data\Managed\</ManagedDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GameVersion)' == '1.6'">
		<TargetFramework>net472</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="'$(GameVersion)' == '1.7'">
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Lib.Harmony" Version="2.4.3" ExcludeAssets="runtime" />
	</ItemGroup>

	<ItemGroup Condition="'$(GameVersion)' == '1.6'">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
		<Reference Include="Assembly-CSharp">
			<HintPath>$(ManagedDir)Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(ManagedDir)UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(ManagedDir)UnityEngine.IMGUIModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.TextRenderingModule">
			<HintPath>$(ManagedDir)UnityEngine.TextRenderingModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(GameVersion)' == '1.7'">
		<Reference Include="Assembly-CSharp">
			<HintPath>..\..\..\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>..\..\..\UnityStubs.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

</Project>
